{
  "expo": {
    "name": "Study Assistant",
    "slug": "study-assistant-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F5FAF8"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app uses the microphone so you can record voice notes for the AI Tutor."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5FAF8"
      },
      "permissions": ["RECORD_AUDIO"]
    },
    "plugins": [
      "expo-router",
      [
        "expo-av",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to access your microphone to record voice notes for the AI Tutor."
        }
      ]
    ],
    "scheme": "studyassistant",
